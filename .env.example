# ============================================================
#  COSMOS OS — environment variables
#  Copy to `.env` and fill in. NEVER commit real keys.
#  Secret keys (SERVICE_ROLE, *_SECRET) must ONLY be used
#  server-side (Supabase Edge Functions / Vercel functions),
#  never shipped in the React frontend.
# ============================================================

# ---------- TIER 1 · MUST-HAVE (makes the app real) ----------
# AI brain: Cosmos Twin, astrologer copilot, Ritual suggestions,
# daily Cosmic Weather, prediction extraction, compatibility insights
OPENAI_API_KEY=sk-...

# Database + Auth + Realtime chat + Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...                  # safe in frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server-side ONLY

# (Vercel needs no key — deploy via `vercel` login)

# ---------- TIER 2 · REAL BUSINESS ----------
# Real video / audio calls + live streams (100ms is India-first)
HMS_ACCESS_KEY=...
HMS_SECRET=...
# (Agora alternative)
# AGORA_APP_ID=...
# AGORA_APP_CERTIFICATE=...

# Payments: wallet recharge, per-min consults, Ritual Moment store
RAZORPAY_KEY_ID=rzp_...
RAZORPAY_KEY_SECRET=...

# Real phone OTP (India SMS)
MSG91_AUTH_KEY=...

# Real kundli / panchang / muhurat (or self-host Swiss Ephemeris — free)
PROKERALA_CLIENT_ID=...
PROKERALA_CLIENT_SECRET=...

# Push notifications (daily horoscope = retention hook)
ONESIGNAL_APP_ID=...
ONESIGNAL_API_KEY=...

# ---------- TIER 3 · POLISH / SCALE ----------
ELEVENLABS_API_KEY=...                    # premium voice (OpenAI TTS also works)
CLOUDINARY_URL=...                        # image/avatar hosting
POSTHOG_KEY=...                           # analytics (DAU/MAU, funnels)
SENTRY_DSN=...                            # error tracking
