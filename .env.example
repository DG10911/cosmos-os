# ============================================================
#  COSMOS OS — Environment / API keys
#  Copy to `.env` (frontend) and Supabase/Vercel secrets (server).
#
#  RULE: VITE_* keys ship to the browser — use ONLY publishable keys.
#  Everything else is SERVER-ONLY (Supabase Edge Functions / Vercel) —
#  a secret in the frontend bundle is a security hole AND disqualifying.
# ============================================================

# ---------- FRONTEND (safe to expose · VITE_ prefix) ----------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...            # publishable anon key
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx         # key-id only (never the secret)
VITE_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx       # push app id
VITE_POSTHOG_KEY=phc_xxxxxxxx                  # product analytics
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_SENTRY_DSN=https://xxxx@oXXX.ingest.sentry.io/XXX
VITE_100MS_TEMPLATE_ID=xxxxxxxx                # room template id (token minted server-side)

# ---------- SERVER-ONLY SECRETS (Edge Functions / Vercel) ----------
# AI
OPENAI_API_KEY=sk-...                          # Cosmos Twin (gpt-4o-mini)
ELEVENLABS_API_KEY=xi-...                      # AI astrologer voice notes
DEEPGRAM_API_KEY=...                           # live call transcription -> Memory Brain

# Astrology engine
PROKERALA_CLIENT_ID=...
PROKERALA_CLIENT_SECRET=...                    # real kundli, dasha, panchang, gun-milan
GEONAMES_USERNAME=...                          # birth-place timezone resolution

# Auth / OTP
MSG91_AUTH_KEY=...                             # phone OTP SMS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...          # server-side DB writes (NEVER in frontend)

# Real-time consultation
HMS_ACCESS_KEY=...                             # 100ms video/audio
HMS_SECRET=...                                 # mint room tokens server-side

# Payments
RAZORPAY_KEY_SECRET=...                        # verify payments / payouts to astrologers
RAZORPAY_WEBHOOK_SECRET=...

# Commerce / fulfillment (Ritual Moment)
SHIPROCKET_EMAIL=...
SHIPROCKET_PASSWORD=...                        # gemstone/remedy shipping

# Memory Brain (AI long-term memory)
PINECONE_API_KEY=...                           # vector store for chart + session memory

# Notifications / lifecycle
ONESIGNAL_REST_API_KEY=...                     # send pushes (Muhurat window, streak rescue)

# Media / images
CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD   # astrologer/user uploads, share-card CDN

# Reports / email
PDFMONKEY_API_KEY=...                          # kundli PDF generation
RESEND_API_KEY=...                             # transactional email
